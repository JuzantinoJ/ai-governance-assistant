# =============================================================
# AI Governance & Incident Assistant — Environment Variables
#
# HOW TO USE:
#   cp .env.example .env
#   Fill in your values in .env
#   Never commit .env to git (it is already in .gitignore)
# =============================================================

# -----------------------------------------------------------
# PostgreSQL database credentials
# These must match exactly between the postgres and n8n service
# -----------------------------------------------------------
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=T1N0_aigovernance
POSTGRES_DB=n8n_governance

# -----------------------------------------------------------
# n8n encryption key
# Encrypts all saved credentials (API keys, OAuth tokens) at rest.
#
# CRITICAL RULES:
#   - Generate with: openssl rand -hex 32
#   - Set this BEFORE your first run
#   - NEVER change it after workflows are active
#   - If lost, all saved credentials become unrecoverable
# -----------------------------------------------------------
N8N_ENCRYPTION_KEY=b9f790732f91aea044c362e922b529004893b749a83aa975fe8525ef72229529

# -----------------------------------------------------------
# n8n host settings
# For local development, leave these as defaults.
# For production with a domain, update accordingly.
# -----------------------------------------------------------
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# -----------------------------------------------------------
# Timezone
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# -----------------------------------------------------------
GENERIC_TIMEZONE=Asia/Kuala_Lumpur

# -----------------------------------------------------------
# AI API keys
# Add your key in n8n's Credentials panel — do NOT put them here.
# This file is a reminder of what credentials you will need.
#
# Required:
#   - OpenAI API key (for GPT-4o)
#     OR Anthropic API key (for Claude)
#   - Google OAuth2 credentials (for Sheets + Gmail)
#
# Set these inside n8n UI under Settings > Credentials
# Never store raw API keys in this file or in your workflow JSON
# -----------------------------------------------------------
# OPENAI_API_KEY=        <-- Set in n8n Credentials panel
# ANTHROPIC_API_KEY=     <-- Set in n8n Credentials panel
